      <interpolate>LINEAR</interpolate>
      <points>
        <point>0,0</point>
        <point>1,1</point>
      </points>
    </load_controller>
  </LoadData>
  <Output>
    <plotfile type="febio" file="results/local_mesh_fine.xplt">
      <var type="displacement" />
      <var type="Lagrange strain" />
      <var type="stress" />
    </plotfile>
    <logfile file="results/local_mesh_fine.log">
      <node_data data="x;y;z" name="conductive_gauge_coordinates" node_set="conductive_gauge_nodes" delim="," />
    </logfile>
  </Output>
</febio_spec>